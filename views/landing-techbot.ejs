    <script>
        // Animación dinámica del Chat
        const messages = [
            { text: "Hola, quisiera información sobre el blanqueamiento láser.", type: "user", delay: 1000 },
            { text: "¡Hola! 👋 Claro que sí. El blanqueamiento láser dura 45 mins y cuesta $1,500 MXN. ¿Te gustaría ver disponibilidad?", type: "bot", delay: 2500 },
            { text: "Sí por favor, para mañana en la tarde", type: "user", delay: 4500 },
            { text: "Para mañana martes tengo un espacio a las 4:30 PM y otro a las 6:00 PM. ¿Te reservo alguno? 🗓️", type: "bot", delay: 6000 }
        ];

        const chatContainer = document.getElementById('chatDemo');

        function playChat() {
            chatContainer.innerHTML = '';
            let currentTime = 0;

            messages.forEach(msg => {
                currentTime += msg.delay;
                setTimeout(() => {
                    const div = document.createElement('div');
                    div.className = `chat-bubble bubble-${msg.type}`;
                    div.innerText = msg.text;
                    chatContainer.appendChild(div);
                }, currentTime);
            });
        }
        
        playChat();
        setInterval(playChat, 10000);

        // Modal
        function openSignup(plan) {
            document.getElementById('selectedPlan').value = plan;
            document.getElementById('signupModal').classList.add('active');
        }
        function closeSignup() {
            document.getElementById('signupModal').classList.remove('active');
        }
        
        document.getElementById('signupModal').addEventListener('click', (e) => {
            if(e.target === document.getElementById('signupModal')) closeSignup();
        });

        // Animación del Carrusel
        const track = document.getElementById('carouselTrack');
        const slides = Array.from(track.children);
        const nav = document.getElementById('carouselNav');
        let currentSlideIndex = 0;
        let slideInterval;

        function getSlidesVisible() {
            if (window.innerWidth <= 600) return 1;
            if (window.innerWidth <= 900) return 2;
            return 3;
        }

        function setupCarousel() {
            nav.innerHTML = '';
            const visible = getSlidesVisible();
            const totalDots = Math.max(1, slides.length - visible + 1);

            for(let i=0; i < totalDots; i++) {
                const dot = document.createElement('button');
                dot.classList.add('carousel-dot');
                if(i === 0) dot.classList.add('active');
                dot.addEventListener('click', () => moveToSlide(i));
                nav.appendChild(dot);
            }
            moveToSlide(0);
        }

        function moveToSlide(index) {
            const visible = getSlidesVisible();
            const maxIndex = Math.max(0, slides.length - visible);
            if (index > maxIndex) index = 0;
            
            const slideWidth = slides[0].getBoundingClientRect().width;
            const gap = parseFloat(window.getComputedStyle(track).gap) || 0;
            
            track.style.transform = `translateX(-${index * (slideWidth + gap)}px)`;
            
            Array.from(nav.children).forEach((dot, i) => {
                dot.classList.toggle('active', i === index);
            });
            currentSlideIndex = index;
            resetInterval();
        }

        function autoPlay() {
            currentSlideIndex++;
            moveToSlide(currentSlideIndex);
        }

        function resetInterval() {
            clearInterval(slideInterval);
            slideInterval = setInterval(autoPlay, 5000);
        }

        window.addEventListener('resize', setupCarousel);
        setupCarousel();

        // Efecto scroll navbar
        window.addEventListener('scroll', () => {
            const nav = document.querySelector('nav');
            if (window.scrollY > 50) {
                nav.style.background = 'rgba(3, 7, 18, 0.95)';
                nav.style.padding = '1rem 5%';
            } else {
                nav.style.background = 'rgba(3, 7, 18, 0.8)';
                nav.style.padding = '1.2rem 5%';
            }
        });
    </script>
