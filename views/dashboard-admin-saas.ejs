<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TechBot Admin | Panel de Control</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --bg-dark: #030712;
            --bg-card: rgba(17, 24, 39, 0.7);
            --bg-card-hover: rgba(31, 41, 55, 0.8);
            --primary: #f59e0b;     
            --primary-glow: rgba(245, 158, 11, 0.4);
            --text-main: #f9fafb;
            --text-muted: #9ca3af;
            --border-light: rgba(255, 255, 255, 0.08);
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-main);
            display: flex;
            min-height: 100vh;
            background-image: 
                radial-gradient(circle at 0% 0%, rgba(245, 158, 11, 0.05) 0%, transparent 40%),
                radial-gradient(circle at 100% 100%, rgba(245, 158, 11, 0.05) 0%, transparent 40%);
        }

        /* Sidebar */
        .sidebar {
            width: 260px;
            background: rgba(3, 7, 18, 0.9);
            backdrop-filter: blur(20px);
            padding: 2rem 1.5rem;
            position: fixed;
            height: 100vh;
            border-right: 1px solid var(--border-light);
            display: flex;
            flex-direction: column;
            z-index: 100;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 10px;
            color: #fff;
            margin-bottom: 3rem;
            padding-left: 0.5rem;
        }

        .logo span {
            background: linear-gradient(135deg, #f59e0b, #fbbf24);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-menu {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            flex: 1;
        }

        .menu-item {
            display: flex;
            gap: 12px;
            align-items: center;
            padding: 0.8rem 1rem;
            color: var(--text-muted);
            text-decoration: none;
            border-radius: 12px;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .menu-item:hover {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-main);
        }

        .menu-item.active {
            background: linear-gradient(135deg, rgba(245, 158, 11, 0.15), rgba(251, 191, 36, 0.05));
            color: var(--primary);
            border: 1px solid rgba(245, 158, 11, 0.2);
        }

        /* Main Content */
        .main-content {
            margin-left: 260px;
            padding: 2.5rem 3rem;
            width: calc(100% - 260px);
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 3rem;
        }

        .header h1 {
            font-size: 2rem;
            font-weight: 700;
            letter-spacing: -0.5px;
        }

        .header p {
            color: var(--text-muted);
            margin-top: 0.5rem;
        }

        .btn-logout {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-light);
            color: var(--text-main);
            padding: 0.6rem 1.2rem;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s;
            font-family: inherit;
        }

        .btn-logout:hover {
            background: rgba(239, 68, 68, 0.1);
            color: var(--danger);
            border-color: rgba(239, 68, 68, 0.2);
        }

        /* KPI Cards */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-bottom: 3rem;
        }

        .kpi-card {
            background: var(--bg-card);
            backdrop-filter: blur(20px);
            padding: 1.8rem;
            border-radius: 20px;
            border: 1px solid var(--border-light);
            position: relative;
            overflow: hidden;
            transition: transform 0.3s;
        }

        .kpi-card:hover {
            transform: translateY(-5px);
            border-color: rgba(255, 255, 255, 0.15);
        }

        .kpi-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 4px; height: 100%;
            background: var(--primary);
            border-radius: 4px 0 0 4px;
        }

        .kpi-title {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.8rem;
        }

        .kpi-value {
            font-size: 2.5rem;
            font-weight: 800;
            color: #fff;
            line-height: 1;
        }

        .kpi-trend {
            font-size: 0.85rem;
            margin-top: 1rem;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .trend-up { color: var(--success); }
        .trend-neutral { color: var(--warning); }

        /* Table */
        .table-container {
            background: var(--bg-card);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            border: 1px solid var(--border-light);
            overflow: hidden;
        }

        .table-header {
            padding: 1.5rem 2rem;
            border-bottom: 1px solid var(--border-light);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .table-header h2 {
            font-size: 1.2rem;
            font-weight: 600;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 1.2rem 2rem;
            text-align: left;
            border-bottom: 1px solid var(--border-light);
        }

        th {
            color: var(--text-muted);
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        tr:last-child td { border-bottom: none; }

        tr:hover td {
            background: rgba(255, 255, 255, 0.02);
        }

        .client-name {
            font-weight: 600;
            color: #fff;
            margin-bottom: 0.2rem;
        }

        .client-email {
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        /* Badges */
        .status-badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            display: inline-block;
        }

        .status-trial { background: rgba(245, 158, 11, 0.1); color: var(--warning); border: 1px solid rgba(245, 158, 11, 0.2); }
        .status-active { background: rgba(16, 185, 129, 0.1); color: var(--success); border: 1px solid rgba(16, 185, 129, 0.2); }
        .status-suspended { background: rgba(239, 68, 68, 0.1); color: var(--danger); border: 1px solid rgba(239, 68, 68, 0.2); }

        .plan-tag {
            background: rgba(255, 255, 255, 0.05);
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 0.8rem;
            border: 1px solid var(--border-light);
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        .plan-tag.ultra {
            background: linear-gradient(135deg, rgba(245, 158, 11, 0.1), rgba(251, 191, 36, 0.05));
            border-color: rgba(245, 158, 11, 0.3);
            color: var(--primary);
        }

        /* Buttons */
        .btn-action {
            padding: 8px 16px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            font-size: 0.85rem;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-family: inherit;
        }

        .btn-view {
            background: rgba(255, 255, 255, 0.05);
            color: #fff;
            border: 1px solid var(--border-light);
        }
        .btn-view:hover { background: rgba(255, 255, 255, 0.1); }

        .btn-delete {
            background: transparent;
            color: var(--text-muted);
            padding: 8px;
        }
        .btn-delete:hover { color: var(--danger); }

        .actions-cell {
            display: flex;
            gap: 8px;
            align-items: center;
        }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="logo"><i class="fa-solid fa-robot"></i> Bot<span>SaaS</span></div>
        <nav class="nav-menu">
            <a href="/admin" class="menu-item active"><i class="fa-solid fa-chart-pie"></i> Panel Principal</a>
            <a href="#" class="menu-item"><i class="fa-solid fa-users"></i> Clientes Suscritos</a>
            <a href="#" class="menu-item"><i class="fa-solid fa-money-bill-wave"></i> Finanzas / Pagos</a>
            <a href="#" class="menu-item"><i class="fa-brands fa-whatsapp"></i> Instancias Twilio</a>
            <a href="#" class="menu-item"><i class="fa-solid fa-gear"></i> Ajustes del Sistema</a>
        </nav>
        
        <div style="margin-top: auto;">
            <button class="btn-logout" onclick="logout()"><i class="fa-solid fa-right-from-bracket"></i> Cerrar Sesión</button>
        </div>
    </aside>

    <main class="main-content">
        <div class="header">
            <div>
                <h1>Visión General</h1>
                <p>Métricas operativas y gestión de suscripciones al <%= new Date().toLocaleDateString('es-MX', {day: 'numeric', month: 'long'}) %></p>
            </div>
        </div>

        <!-- KPIs -->
        <div class="kpi-grid">
            <div class="kpi-card" style="--primary: #10b981;">
                <div class="kpi-title">Ingreso Mensual (MRR)</div>
                <div class="kpi-value">$<%= businesses.reduce((acc, b) => acc + (b.plan === 'ultra' ? 3499 : (b.plan === 'pro' ? 1499 : 0)), 0).toLocaleString() %></div>
                <div class="kpi-trend trend-up"><i class="fa-solid fa-arrow-trend-up"></i> +12.5% este mes</div>
            </div>
            
            <div class="kpi-card" style="--primary: #f59e0b;">
                <div class="kpi-title">Clientes Registrados</div>
                <div class="kpi-value"><%= businesses.length %></div>
                <div class="kpi-trend trend-up"><i class="fa-solid fa-user-plus"></i> +3 nuevos esta semana</div>
            </div>
            
            <div class="kpi-card" style="--primary: #6366f1;">
                <div class="kpi-title">Números Activos (Twilio)</div>
                <div class="kpi-value"><%= businesses.filter(b => b.twilioConfig?.status === 'active').length %></div>
                <div class="kpi-trend trend-neutral"><i class="fa-solid fa-clock"></i> <%= businesses.filter(b => b.twilioConfig?.status === 'pending').length %> en proceso de activación</div>
            </div>
        </div>

        <!-- Table -->
        <div class="table-container">
            <div class="table-header">
                <h2>Directorio de Clientes</h2>
            </div>
            <table>
                <thead>
                    <tr>
                        <th>Negocio</th>
                        <th>Suscripción</th>
                        <th>Estado</th>
                        <th>WhatsApp Bot</th>
                        <th>Fin del Trial</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <% if(businesses.length === 0) { %>
                        <tr>
                            <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 3rem;">
                                No hay clientes registrados aún.
                            </td>
                        </tr>
                    <% } %>
                    <% businesses.forEach(business => { %>
                        <tr>
                            <td>
                                <div class="client-name"><%= business.businessName %></div>
                                <div class="client-email"><%= business.contactEmail %></div>
                            </td>
                            <td>
                                <span class="plan-tag <%= business.plan === 'ultra' ? 'ultra' : '' %>">
                                    <%= business.plan.toUpperCase() %>
                                </span>
                            </td>
                            <td>
                                <span class="status-badge status-<%= business.subscriptionStatus %>">
                                    <%= business.subscriptionStatus.charAt(0).toUpperCase() + business.subscriptionStatus.slice(1) %>
                                </span>
                            </td>
                            <td>
                                <% if (business.twilioConfig?.phoneNumber) { %>
                                    <span style="color: #f9fafb;"><%= business.twilioConfig.phoneNumber %></span>
                                <% } else { %>
                                    <span style="color: var(--text-muted);"><i class="fa-solid fa-spinner fa-spin"></i> Pendiente</span>
                                <% } %>
                            </td>
                            <td>
                                <% if (business.trialEndsAt) { %>
                                    <span style="color: <%= new Date(business.trialEndsAt) < new Date() ? 'var(--danger)' : 'inherit' %>">
                                        <%= new Date(business.trialEndsAt).toLocaleDateString('es-MX') %>
                                    </span>
                                <% } else { %>
                                    <span style="color: var(--text-muted);">N/A</span>
                                <% } %>
                            </td>
                            <td>
                                <div class="actions-cell">
                                    <a href="/dashboard-pro/<%= business._id %>" target="_blank" class="btn-action btn-view">
                                        <i class="fa-solid fa-arrow-up-right-from-square"></i> Entrar
                                    </a>
                                    <button class="btn-action btn-delete" onclick="deleteBusiness('<%= business._id %>')" title="Eliminar cuenta">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </main>

    <script>
        function deleteBusiness(businessId) {
            if (confirm('⚠️ ¿Estás seguro de eliminar PERMANENTEMENTE este cliente y todo su historial de citas/bot?')) {
                fetch('/api/admin/businesses/' + businessId, { method: 'DELETE' })
                .then(response => {
                    if (response.ok) {
                        alert('Cliente eliminado exitosamente.');
                        location.reload();
                    } else {
                        alert('Hubo un error al eliminar al cliente.');
                    }
                });
            }
        }

        function logout() {
            // Eliminar token cookie setting exp
            document.cookie = "token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
            window.location.href = '/auth/login';
        }
    </script>
</body>
</html>